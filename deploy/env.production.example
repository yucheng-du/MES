MES_DOMAIN=mes.example.com
# Use a long random URL-safe value (letters/numbers/-/_), because it is part of DATABASE_URL.
POSTGRES_PASSWORD=replace_with_a_long_random_password
FACTORY_TIMEZONE=Asia/Shanghai
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=device/send/+

# Optional Andon escalation webhook. Leave blank to keep alarms local.
# HTTPS JSON endpoint; the receiver must deduplicate by Idempotency-Key.
ANDON_WEBHOOK_URL=
ANDON_WEBHOOK_TOKEN=

# Optional SMS sign-in gateway; blank disables SMS sign-in.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
