DATABASE_URL=postgres://mes:change_me@127.0.0.1:5432/mes
TEST_DATABASE_URL=postgres://mes:change_me@127.0.0.1:5432/mes_test
EQUIPMENT_TEST_DATABASE_URL=postgres://mes:change_me@127.0.0.1:5432/mes_equipment_parity_test
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
HOST=127.0.0.1
PORT=4300
FACTORY_TIMEZONE=Asia/Shanghai
# Optional equipment integration, credentials remain on server
# MQTT_URL=mqtts://broker.example.com:8883
# MQTT_USERNAME=mes_ingest
# MQTT_PASSWORD=
# MQTT_TOPIC=device/send/+

# Optional SMS login: an HTTPS gateway accepting {mobile, code, expiresInSeconds}.
# Enable only after configuring your own provider. Keep the token private.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# Optional Andon escalation webhook. Leave blank to keep alarms local.
# HTTPS JSON endpoint; the receiver must deduplicate by Idempotency-Key.
ANDON_WEBHOOK_URL=
ANDON_WEBHOOK_TOKEN=
